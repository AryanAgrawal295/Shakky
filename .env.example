# MongoDB Atlas connection string. Add the real value in Vercel's Environment Variables.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB=shake_lab

# Change both before allowing staff access outside local development.
SHAKE_LAB_ADMIN_PASSWORD=change-me-admin
SHAKE_LAB_ADMIN_SECRET=replace-with-a-long-random-secret
